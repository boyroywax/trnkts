{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@trnkts/*": ["../*/src", "../*/dist"]
    }
  },
  "include": ["src/**/*", "src/**/*.test.ts", "src/**/*.spec.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [
    {
      "path": "../utils"
    }
  ]
}
